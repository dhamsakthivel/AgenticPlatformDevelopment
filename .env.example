# Copy to .env and fill in the values you have. .env is git-ignored.
# Profile: local uses mocks. sandbox points at trial Azure DevOps, qTest, and ServiceNow.

SPRING_PROFILES_ACTIVE=local

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_CHAT_MODEL_SMALL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

ADO_ORG_URL=https://dev.azure.com/<org>
ADO_PROJECT=
ADO_PAT=
ADO_WEBHOOK_SECRET=

QTEST_BASE_URL=http://localhost:8091
QTEST_TOKEN=
QTEST_PROJECT_ID=
# Optional. The local mock uses project 1 and module 1 when these are unset.
# QTEST_MODULE_ID=1
# QTEST_STATUS_FIELD_ID=
# STORIES_SEED_PATH=scripts/seed/stories.json

SERVICENOW_INSTANCE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

ENROLLMENT_APP_URL=http://localhost:8092

TEMPORAL_TARGET=localhost:7233

LLM_PRICE_TABLE=classpath:llm-prices.yml
