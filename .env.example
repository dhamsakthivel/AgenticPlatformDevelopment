# Shared dev key. The browser never sees this; Next.js server actions send it to Spring.
AKE_API_KEY=dev-ake-key
PLATFORM_API_URL=http://localhost:8080
PLATFORM_API_KEY=dev-ake-key

# Agent runtime
AKE_AGENT_URL=http://localhost:8000
AKE_AGENT_API_KEY=dev-ake-key

# Optional LLM. Without a key the agent uses a local hashing embedder and a rubric drafter.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AKE_CHAT_MODEL=gpt-4o-mini
AKE_EMBED_MODEL=text-embedding-3-small

# LangSmith. Leave blank to keep traces local.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ake-user-story
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# local = in-memory documents and stories. cloud = MongoDB + PostgreSQL.
AKE_PROFILE=local
AKE_STORAGE=memory

# Used when AKE_PROFILE=cloud
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ake
SPRING_DATASOURCE_USERNAME=ake
SPRING_DATASOURCE_PASSWORD=ake
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ake
DATABASE_URL=postgresql://ake:ake@localhost:5432/ake
