{
  "type": "object",
  "additionalProperties": false,
  "required": ["storyId", "summary", "criteria", "ambiguities", "missingScenarios", "riskScore", "riskReasons", "citations"],
  "properties": {
    "storyId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "testable", "issue"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "testable": { "type": "boolean" },
          "issue": { "type": ["string", "null"] }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "severity"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH"] }
        }
      }
    },
    "missingScenarios": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "riskScore": { "type": "integer", "minimum": 1, "maximum": 5 },
    "riskReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunkId", "source"],
        "properties": {
          "chunkId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
